{
  "_comment": [
    "Single source of truth for every dataset the engine reads or writes.",
    "No table name, view name or file path is hardcoded in Python — it is all here.",
    "",
    "Every entry is a declarative spec read by matching.io.read():",
    "    {\"format\": \"delta\",   \"table\": \"catalog.schema.name\"}",
    "    {\"format\": \"parquet\", \"path\":  \"/Volumes/cat/sch/vol/operator/\"}",
    "    {\"format\": \"csv\",     \"path\":  \"/Volumes/...\", \"options\": {\"header\": \"true\"}}",
    "To move a source from a table to Parquet files, change format/table -> format/path",
    "HERE. No engine code changes: every read goes through the one read() function.",
    "",
    "${schema} expands to the 'schema' value below, so one edit repoints every",
    "engine-owned table at another catalog/schema.",
    "",
    "Precedence: target_schema / source / golden_source in conf/base.json or",
    "conf/countries/{CC}.json still override this file (used by the tests to point at a",
    "scratch schema). MDM_CONF_DIR relocates the whole conf/ folder; MDM_STORAGE_CONFIG",
    "points at this one file. See docs/DEPLOYMENT.md."
  ],

  "schema": "pds_auroradsar_prod.schema_informatica",

  "sources": {
    "_comment": "Read-only inputs. Any supported format — these are the ones to switch to files.",

    "operator": {
      "format": "delta",
      "table": "sl_bdl_processed_cd_prod.cd.vw_ufsoperator"
    },
    "golden": {
      "format": "delta",
      "table": "sl_bdl_processed_cd_prod.cd.vw_ufsoperatorgoden"
    },
    "enriched_operators": {
      "format": "delta",
      "table": "${schema}.mdmenrichedoperators"
    },
    "informatica_undermatch": {
      "format": "delta",
      "table": "${schema}.vw_informatica_undermatch"
    },
    "informatica_overmatch": {
      "format": "delta",
      "table": "${schema}.vw_informatica_overmatch"
    }
  },

  "tables": {
    "_comment": [
      "Engine-owned Delta tables, created by sql/setup_tables.sql. The engine reads AND",
      "writes these as country slices (replaceWhere / DELETE WHERE CountryCode), so they",
      "must stay format 'delta' with a 'table' name — a path/parquet spec is rejected."
    ],

    "row_registry":       {"format": "delta", "table": "${schema}.MDMRowRegistry"},
    "golden_id_sequence": {"format": "delta", "table": "${schema}.MDMGoldenIdSequence"},
    "golden_id_history":  {"format": "delta", "table": "${schema}.MDMGoldenIdHistory"},
    "change_log":         {"format": "delta", "table": "${schema}.operator_golden_changelog"},
    "rule_results":       {"format": "delta", "table": "${schema}.MDMRuleResults"},
    "rule_evaluations":   {"format": "delta", "table": "${schema}.MDMRuleEvaluations"},
    "match_exclusions":   {"format": "delta", "table": "${schema}.MDMMatchExclusions"},
    "matching_state":     {"format": "delta", "table": "${schema}.MDMMatchingState"},
    "match_links":        {"format": "delta", "table": "${schema}.MDMMatchLinks"},
    "component_labels":   {"format": "delta", "table": "${schema}.MDMComponentLabels"},
    "matched_results":    {"format": "delta", "table": "${schema}.MDMMatchedResults"}
  }
}
