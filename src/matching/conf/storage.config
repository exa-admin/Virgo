{
  "_comment": [
    "Every table, view and path the engine touches. Nothing storage-related is in Python.",
    "Specs: {format: delta, table: ...} or {format: parquet|csv, path: ..., options: {...}}.",
    "${schema} expands to the schema below. Overrides: docs/DEPLOYMENT.md."
  ],
  "schema": "pds_auroradsar_prod.schema_informatica",

  "sources": {
    "_comment": "Read-only. Switch these to files by swapping table -> path.",

    "operator": {
      "format": "delta",
      "table": "sl_bdl_processed_cd_prod.cd.vw_ufsoperator"
    },
    "golden": {
      "format": "delta",
      "table": "sl_bdl_processed_cd_prod.cd.vw_ufsoperatorgolden"
    },
    "enriched_operators": {
      "format": "delta",
      "table": "${schema}.mdmenrichedoperators"
    },
    "informatica_undermatch": {
      "format": "delta",
      "table": "${schema}.vw_informatica_undermatch"
    },
    "informatica_overmatch": {
      "format": "delta",
      "table": "${schema}.vw_informatica_overmatch"
    }
  },

  "tables": {
    "_comment": "Written as country slices, so these must stay Delta tables with a name.",

    "row_registry":       {"format": "delta", "table": "${schema}.mdm_row_registry"},
    "golden_id_sequence": {"format": "delta", "table": "${schema}.mdm_golden_id_sequence"},
    "golden_id_history":  {"format": "delta", "table": "${schema}.mdm_golden_id_history"},
    "change_log":         {"format": "delta", "table": "${schema}.operator_golden_changelog"},
    "rule_results":       {"format": "delta", "table": "${schema}.mdm_rule_results"},
    "rule_evaluations":   {"format": "delta", "table": "${schema}.mdm_rule_evaluations"},
    "match_exclusions":   {"format": "delta", "table": "${schema}.mdm_match_exclusions"},
    "matching_state":     {"format": "delta", "table": "${schema}.mdm_matching_state"},
    "match_links":        {"format": "delta", "table": "${schema}.mdm_match_links"},
    "component_labels":   {"format": "delta", "table": "${schema}.mdm_component_labels"},
    "matched_results":    {"format": "delta", "table": "${schema}.mdm_matched_results"}
  }
}
