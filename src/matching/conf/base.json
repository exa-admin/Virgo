{
  "_comment": [
    "Cross-country matching BEHAVIOUR. Where the data lives is in conf/storage.config —",
    "do not add table names or paths here.",
    "Optional escape hatch: target_schema / source / golden_source may still be set here",
    "(or in a country file) to override storage.config for one environment. The test",
    "harness uses exactly that to point the engine at a scratch schema."
  ],
  "EnrichDate": false,
  "priorityMatching": true,
  "golden_id_floor": 100000000,
  "preserve_source_golden_groups": true,
  "allow_source_golden_group_merge": false,
  "components_max_iterations": 30,
  "rule_evaluation_detail": "matched",
  "component_label_detail": "final",
  "invalid_values": [
    "",
    "null",
    "nan",
    "na",
    "n/a",
    "0",
    "00",
    "000",
    "0000",
    "dummy",
    "test",
    "0.0",
    "0.00",
    "0.000",
    "0.0000",
    "0.0000000",
    "-",
    "--"
  ],
  "exclude_from_match_filters": [
    "lower(OperatorName) LIKE '%invalid%'",
    "lower(OperatorName) LIKE '%dummy%'",
    "ZipCode IN ('00000', '99999')"
  ],
  "standardization": {
    "name_column": "OperatorName",
    "city_column": "CityText",
    "state_column": "StateText",
    "zip_column": "ZipCode",
    "address_columns": [
      "HouseNumberText",
      "HouseNumberExtensionText",
      "StreetText"
    ]
  }
}
